{
  "name": "@nfq/feature-flags",
  "version": "16.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Add feature flags to babel, nextjs, SWC, react and default js code",
  "main": "target/wasm32-wasip1/release/nfq_feature_flags.wasm",
  "bin": {
    "nfq-generate-types": "./cli.js"
  },
  "exports": {
    ".": {
      "default": "./target/wasm32-wasip1/release/nfq_feature_flags.wasm"
    },
    "./babel": {
      "import": "./babel/index.js",
      "require": "./babel/index.js"
    },
    "./webpack": {
      "import": "./webpack/index.js",
      "require": "./webpack/index.js"
    },
    "./eslint": {
      "import": "./eslint/index.js",
      "require": "./eslint/index.js"
    },
    "./next": {
      "import": "./next/index.js",
      "require": "./next/index.js"
    },
    "./sass": {
      "import": "./scss/index.js",
      "require": "./scss/index.js"
    },
    "./features": {
      "default": "./scss/_feature-flags.scss"
    },
    "./features/config": {
      "default": "./scss/_config.scss"
    }
  },
  "sideEffects": false,
  "scripts": {
    "deploy": "standard-version --release-as 16.4.2 && git push --follow-tags origin master && npm publish",
    "prepublishOnly": "cargo +nightly build-wasi --release",
    "lint": "eslint ./babel ./eslint ./next ./scss ./webpack --ext='.js' --ext='.jsx' --ext='.ts' --ext='.tsx'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfqde/nfq-feature-flags.git"
  },
  "keywords": [
    "feature-flags",
    "feature",
    "next",
    "flags",
    "babel",
    "react"
  ],
  "author": ".NFQ | Christoph Kruppe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nfqde/nfq-feature-flags/issues"
  },
  "homepage": "https://github.com/nfqde/nfq-feature-flags#readme",
  "dependencies": {
    "colors": "1.4.0",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nfq/eslint-config": "4.0.0-beta.23",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  }
}
